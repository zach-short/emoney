# Copy to /etc/emoney/emoney.env on the VM:
#   sudo install -d -m 0750 -o root -g emoney /etc/emoney
#   sudo install -m 0640 -o root -g emoney /dev/null /etc/emoney/emoney.env
#   sudo nano /etc/emoney/emoney.env
#
# systemd reads this as literal KEY=VALUE -- no shell quoting, no expansion.
# Do not wrap the Mongo URI in quotes; they become part of the value.

DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=emoney
PORT=8080
GIN_MODE=release
